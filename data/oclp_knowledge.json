{
  "schema_version": 1,
  "checked_at": "2026-09-22",
  "sources": {
    "faq": "https://dortania.github.io/OpenCore-Legacy-Patcher/FAQ",
    "models": "https://dortania.github.io/OpenCore-Legacy-Patcher/MODELS.html",
    "post_install": "https://dortania.github.io/OpenCore-Legacy-Patcher/POST-INSTALL.html",
    "patch_explain": "https://dortania.github.io/OpenCore-Legacy-Patcher/PATCHEXPLAIN.html"
  },
  "target_os": {
    "minimum_major": 11,
    "maximum_major": 15,
    "statement": "Current official OCLP documentation targets macOS Big Sur 11.x through macOS Sequoia 15.x. Versions outside this range are not supported by the documented target range."
  },
  "root_patch": {
    "state_model": [
      "not_detected",
      "detected",
      "unknown"
    ],
    "domains": [
      "graphics",
      "wifi",
      "bluetooth",
      "t1",
      "camera",
      "usb"
    ],
    "gpu_requirements": {
      "big_sur": [
        "tesla",
        "terascale",
        "iron lake",
        "sandy bridge"
      ],
      "monterey": [
        "tesla",
        "kepler",
        "terascale",
        "iron lake",
        "sandy bridge",
        "ivy bridge"
      ],
      "ventura": [
        "tesla",
        "kepler",
        "terascale",
        "gcn",
        "polaris",
        "iron lake",
        "sandy bridge",
        "ivy bridge",
        "haswell",
        "broadwell",
        "skylake"
      ],
      "sonoma": [
        "tesla",
        "kepler",
        "terascale",
        "gcn",
        "polaris",
        "iron lake",
        "sandy bridge",
        "ivy bridge",
        "haswell",
        "broadwell",
        "skylake"
      ],
      "sequoia": [
        "tesla",
        "kepler",
        "terascale",
        "gcn",
        "polaris",
        "iron lake",
        "sandy bridge",
        "ivy bridge",
        "haswell",
        "broadwell",
        "skylake"
      ]
    },
    "package_requirements": {
      "metallib_support_pkg": [
        "ivy bridge",
        "haswell",
        "kepler"
      ],
      "kdk": [
        "gcn"
      ]
    }
  },
  "hardware_compatibility": {
    "wifi": {
      "source": "patch_explain",
      "documented_chipsets": [
        "BCM943224",
        "BCM94331",
        "BCM94360",
        "BCM943602",
        "BCM94328",
        "BCM94322",
        "Atheros"
      ],
      "note": "OCLP documents legacy and compatibility Wi-Fi handling for these chipset families."
    },
    "bluetooth": {
      "source": "patch_explain",
      "documented_chipsets": [
        "BCM94360",
        "BCM2070",
        "BCM2046"
      ],
      "note": "OCLP documents Bluetooth fixes/spoofing for these chipset families and pre-BCM94360 wireless cards."
    },
    "t1": {
      "source": "post_install",
      "documented_evidence_terms": [
        "T1",
        "Apple Security"
      ],
      "note": "T1 support is a documented root-patch domain; hardware presence must come from system evidence."
    },
    "usb_1_1": {
      "source": "post_install",
      "documented_controller_terms": [
        "OHCI",
        "UHCI",
        "USB 1.1"
      ],
      "note": "OCLP documents USB 1.1 root patches for affected legacy systems."
    },
    "camera": {
      "source": "post_install",
      "documented_evidence_terms": [
        "iSight",
        "FaceTime Camera",
        "AppleCamera"
      ],
      "note": "OCLP documents built-in camera root patches; absence of IORegistry evidence is unknown."
    }
  }
}
